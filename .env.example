# Required in production: 32+ random characters used to sign session tokens.
LEDGERLANE_SESSION_SECRET=replace-with-a-random-32-character-secret
PORT=3000
NODE_ENV=production
ALLOW_DEMO=false
LEDGERLANE_DATA_DIR=./data

# Lemon Squeezy subscription checkout and signed webhook.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_GROWTH=
LEMONSQUEEZY_VARIANT_SCALE=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Google Gemini. Keep this server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
APP_URL=http://localhost:3000
